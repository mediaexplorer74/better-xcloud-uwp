<Page
    x:Class="BetterXCloudUWP.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BetterXCloudUWP.Views">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock Text="Настройки пользователя" FontSize="24"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Имя пользователя:" VerticalAlignment="Center"/>
            <TextBox x:Name="UserNameBox" Width="200"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Xbox Cloud API Endpoint:" VerticalAlignment="Center"/>
            <TextBox x:Name="XCloudEndpointBox" Width="350"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Регион по умолчанию:" VerticalAlignment="Center"/>
            <TextBox x:Name="DefaultRegionBox" Width="120"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="TitleId (Game):" VerticalAlignment="Center"/>
            <TextBox x:Name="DefaultTitleIdBox" Width="120"/>
        </StackPanel>
        <Button Content="Сохранить" Click="SaveButton_Click" Width="120"/>
        <TextBlock x:Name="SaveStatus" FontSize="16" Foreground="Green" Visibility="Collapsed"/>
    </StackPanel>
</Page>
