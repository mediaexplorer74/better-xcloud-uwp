<Page
    x:Class="BetterXCloudUWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BetterXCloudUWP"
    xmlns:views="using:BetterXCloudUWP.Views"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
            <Border x:Name="InputArea" BorderBrush="Gray" BorderThickness="2" 
                    Width="350" Height="200" Background="#22CCCCCC" KeyDown="InputArea_KeyDown" KeyUp="InputArea_KeyUp" PointerPressed="InputArea_PointerPressed" PointerMoved="InputArea_PointerMoved" 
                    PointerReleased="InputArea_PointerReleased" 
                    >
                <TextBlock x:Name="InputText" Text="Сюда кликните мышью или коснитесь, чтобы тестировать ввод..." 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" TextWrapping="Wrap"/>
            </Border>
            <TextBlock Text="Better xCloud UWP" HorizontalAlignment="Center" FontSize="36"/>
            <TextBlock x:Name="StatusText" Text="Статус: Остановлен" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock x:Name="FpsText" Text="FPS: 0" FontSize="18" HorizontalAlignment="Center"/>
            <TextBlock x:Name="GamepadStatusText" Text="Геймпад: не подключен" FontSize="16" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <Button x:Name="StartStreamButton" Content="Старт стрима" Click="StartStreamButton_Click"/>
                <Button x:Name="StopStreamButton" Content="Стоп стрима" Click="StopStreamButton_Click"/>
            </StackPanel>
            <views:NotificationControl x:Name="Notification" Visibility="Collapsed">
                <!-- Add any required child elements or properties here -->
            </views:NotificationControl>
            <Button Content="Настройки" Click="SettingsButton_Click" HorizontalAlignment="Center" Width="120"/>
            <Button Content="Войти в Xbox Live" Click="XboxAuthButton_Click" HorizontalAlignment="Center" Width="180"/>
            <Button Content="Потоковое видео" Click="StreamPageButton_Click" HorizontalAlignment="Center" Width="180"/>
        </StackPanel>
    </Grid>
</Page>
